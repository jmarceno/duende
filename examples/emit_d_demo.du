// Example demonstrating the --emit-d flag
// This simple program shows how to use --emit-d to generate D code without compiling

import std.math

enum Color do
    Red, Green, Blue
end

int calculateDistance(float x1, float y1, float x2, float y2) do
    let float dx = abs(x1 - x2)
    let float dy = abs(y1 - y2)
    return sqrt(pow(dx, 2.0) + pow(dy, 2.0))
end

int main() do
    let float x1 = 0.0
    let float y1 = 0.0
    let float x2 = 3.0
    let float y2 = 4.0
    
    let float distance = calculateDistance(x1, y1, x2, y2)
    let Color color = Color.Red
    
    print("Distance between points: " + formatFloat(distance, 2))
    print("Color: " + String(color))
    
    return 0
end