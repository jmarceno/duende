int main() do
    var list<int> numbers = [1, 2, 3, 4, 5]
    numbers.add(6)

    let int first = numbers[0]
    print("First: ${first}")

    var dict<string, int> config = {"port": 8080}
    if config.has("port") do
        let int port = config["port"] // a missing key aborts; has is the check
        print("Port: ${port}")
    else
        print("No port specified at config")

        for entry in config.items() do
            print("${entry.key}: ${entry.value}")
        end
    end
end
