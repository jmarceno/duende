import std.math

func test() {
    // Using math function without import
    let x = sqrt(16.0)  // This should work since we have the import
    
    // This should cause an error since we don't import std.hash
    let y = hash("test")  // Error: missing import
}

func main() {
    test()
    
    // More missing import usage
    print(digest("data"))  // Error: missing std.digest import
}